{
  "name": "typographizer-js",
  "version": "0.5.1",
  "description": "A script to fix typographic errors",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "scripts": {
    "test": "ava && npm run test:perf",
    "test:perf": "ava --config ava.perf.config.js",
    "test:perf:watch": "ava --config ava.perf.config.js --watch",
    "test:watch": "ava --watch",
    "test:coverage": "c8 ava",
    "bench": "node test/perf/cli.ts",
    "bench:compare": "node test/perf/compare-cli.ts",
    "build": "tsc -p tsconfig.build.json && rollup -c",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ovlb/typographizer-js.git"
  },
  "keywords": [
    "typography",
    "text formatting",
    "design"
  ],
  "author": {
    "name": "Oscar Braunert",
    "url": "https://www.ovl.design",
    "email": "o@ovl.design"
  },
  "engines": {
    "node": "^22.20.0 || >=24"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ovlb/typographizer-js/issues"
  },
  "homepage": "https://github.com/ovlb/typographizer-js#readme",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ava": "^8.1.2",
    "c8": "^12.0.0",
    "eslint": "^10.13.0",
    "neostandard": "^0.14.1",
    "rollup": "^4.65.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ]
}
